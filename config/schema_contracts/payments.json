
{
  "dataset": "payments",
  "contract_version": "1.0",
  "description": "Approved schema for insurance payment extracts",
  "business_key": ["payment_id"],
  "required_columns": [
    "payment_id",
    "policy_id",
    "payment_amount",
    "payment_date",
    "payment_status",
    "updated_at"
  ],
  "columns": {
    "payment_id": "string",
    "policy_id": "string",
    "payment_amount": "number",
    "payment_date": "date",
    "payment_status": "string",
    "updated_at": "timestamp"
  },
  "rules": {
    "business_key_not_null": true,
    "business_key_unique_within_batch": true,
    "allow_unexpected_columns": false,
    "allow_missing_required_columns": false
  }
}
